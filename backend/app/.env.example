# Environment
NODE_ENV=development

# Server — the frontend dev proxy expects the backend on 4002 (see frontend/next.config.mjs)
PORT=4002

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/fitness

# JWT Authentication
# IMPORTANT: In production, generate secure random strings with at least 32 characters
# Example command: openssl rand -base64 32
JWT_SECRET=your-secure-secret-key-minimum-32-characters-required-for-production
JWT_REFRESH_SECRET=another-secure-secret-key-minimum-32-characters-for-refresh-tokens

# Redis (optional — caching/sessions; tests expect redis://localhost:6380)
REDIS_URL=redis://localhost:6379

# CORS
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# OpenAI (optional — powers the in-app fitness assistant; a placeholder is used if unset)
# OPENAI_API_KEY=

# Web Push notifications (optional — generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
